---
// Navegación: superpuesta al hero (oscuro). No fija; el contacto rápido
// vive en el botón flotante de WhatsApp.
---

<header class="nav">
  <div class="container nav-inner">
    <a class="logo" href="#inicio" aria-label="Gustavo Gonik, inicio">
      Gustavo Gonik<span class="dot" aria-hidden="true"></span>
    </a>
    <nav aria-label="Secciones del sitio">
      <ul>
        <li><a href="#tasacion">Tasación</a></li>
        <li><a href="#cursos">Cursos</a></li>
        <li><a href="#asesoramiento">Asesoramiento</a></li>
        <li><a href="#contacto" class="nav-contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    padding-block: var(--space-md);
  }

  .nav-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--on-dark);
    text-decoration: none;
    white-space: nowrap;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem clamp(1rem, 3vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--on-dark-muted);
    text-decoration: none;
    padding-block: 0.5rem; /* objetivo táctil */
    transition: color 160ms var(--ease-out-quart);
  }

  nav a:hover {
    color: var(--on-dark);
  }

  .nav-contacto {
    color: var(--on-dark);
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--line-dark);
    transition: box-shadow 160ms var(--ease-out-quart), background-color 160ms var(--ease-out-quart);
  }

  .nav-contacto:hover {
    color: var(--on-dark);
    box-shadow: inset 0 0 0 1.5px var(--rojo);
    background: oklch(0.55 0.19 30 / 0.12);
  }

  @media (max-width: 40rem) {
    .nav-inner {
      justify-content: center;
      text-align: center;
    }

    ul {
      gap: 1.1rem;
    }
  }
</style>
