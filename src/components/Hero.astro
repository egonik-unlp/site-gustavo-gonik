---
interface Props {
  whatsappUrl: string;
}

const { whatsappUrl } = Astro.props;

// Obra del hero: bodegón barroco de fondo oscuro, dialoga con la tinta.
const obraHero =
  'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=900&q=80';
---

<section class="hero" id="inicio">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="linea"><span>¿Cuánto vale</span></span>
        <span class="linea"><span>esa obra que</span></span>
        <span class="linea"><span>tenés en casa?<span class="dot dot-hero" aria-hidden="true"></span></span></span>
      </h1>
      <p class="hero-sub">
        Soy Gustavo Gonik, experto en arte. Taso obras y colecciones, doy
        cursos para aprender a mirar el mercado y te ayudo a elegir arte
        para tus espacios.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-rojo" href={whatsappUrl}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.4-.7-2.9-1.1-4.7-4-4.9-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.9 2.1c0 .2.1.4 0 .6l-.4.6-.4.5c-.2.1-.3.3-.1.6.1.3.7 1.1 1.5 1.9 1 .9 1.9 1.2 2.2 1.3.3.2.4.1.6 0l.8-1c.2-.3.4-.2.7-.1l2.1 1c.3.1.5.2.6.4 0 .1 0 .7-.1 1.3Z"/></svg>
          Escribime por WhatsApp
        </a>
        <a class="btn btn-ghost-dark" href="#tasacion">Ver cómo trabajo</a>
      </div>
    </div>

    <figure class="hero-obra">
      <div class="marco marco-hero">
        <img
          src={obraHero}
          alt="Bodegón barroco: flores sobre fondo negro en un jarrón de metal, obra de Abraham Mignon"
          width="720"
          height="920"
          fetchpriority="high"
        />
        <span class="dot-vendido" aria-hidden="true" title="Vendida"></span>
      </div>
      <figcaption class="label-obra label-hero">
        <strong>Abraham Mignon</strong> · Flores en un jarrón de metal, óleo
        sobre lienzo. El punto rojo significa «vendida»: así se marca en una
        galería.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    background: var(--tinta-deep);
    color: var(--on-dark);
    padding-block: clamp(7rem, 14vh, 10rem) var(--space-section);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }

  h1 {
    font-size: var(--text-hero);
    color: oklch(1 0 0);
  }

  /* Coreografía de entrada: cada línea se revela con máscara */
  .linea {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .linea > span {
    display: inline-block;
    animation: subir 800ms var(--ease-out-expo) both;
  }

  .linea:nth-child(2) > span { animation-delay: 90ms; }
  .linea:nth-child(3) > span { animation-delay: 180ms; }

  @keyframes subir {
    from { transform: translateY(110%); }
    to { transform: translateY(0); }
  }

  .dot-hero {
    width: 0.18em;
    height: 0.18em;
    margin-left: 0.1em;
    animation: aparecer-dot 400ms var(--ease-out-quint) 950ms both;
  }

  @keyframes aparecer-dot {
    from { transform: scale(0) translateY(-0.06em); }
    to { transform: scale(1) translateY(-0.06em); }
  }

  .hero-sub {
    max-width: 46ch;
    margin-top: var(--space-md);
    font-size: var(--text-lead);
    font-weight: 450;
    line-height: 1.65;
    letter-spacing: 0.01em;
    color: var(--on-dark-muted);
    animation: fundir 700ms var(--ease-out-quart) 350ms both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    animation: fundir 700ms var(--ease-out-quart) 500ms both;
  }

  @keyframes fundir {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  /* La obra: colgada, con sticker de vendida */
  .hero-obra {
    margin: 0;
    animation: fundir-obra 900ms var(--ease-out-quint) 250ms both;
  }

  @keyframes fundir-obra {
    from { opacity: 0; transform: scale(1.04); }
    to { opacity: 1; transform: none; }
  }

  .marco-hero {
    position: relative;
    aspect-ratio: 4 / 5;
    box-shadow: 0 30px 60px -20px oklch(0 0 0 / 0.5);
  }

  .dot-vendido {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--rojo);
    box-shadow: 0 0 0 3px oklch(1 0 0 / 0.9);
    animation: aparecer-vendido 450ms var(--ease-out-quint) 1100ms both;
  }

  @keyframes aparecer-vendido {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }

  .label-hero {
    margin-top: var(--space-sm);
    max-width: 38ch;
    color: var(--on-dark-muted);
  }

  .label-hero strong {
    color: var(--on-dark);
  }

  @media (max-width: 56rem) {
    .hero {
      padding-top: clamp(8rem, 18vh, 10rem);
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-obra {
      max-width: 26rem;
    }
  }
</style>
